#include <c_std.mlang>

struct Vec {
    int x;
    int y;
}
func Vec.print() {
    c_std::printf("Vec[%d, %d]\n", this.x, this.y);
}
func static Vec.signature() {
    c_std::printf("Vec[int, int]\n");
}

func main() -> int {
    Vec ve;
    ve = Vec{1212, 3};
    ve.print();
    Vec.signature();
    return 0;
}
